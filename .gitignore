# --- colcon / ROS 2 build artifacts ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Windows NTFS alternate-data-stream junk (from copying off C:) ---
*:Zone.Identifier

# --- Trial outputs ---
# The erc_images/ folder stays tracked (the spec requires it to exist in the
# repo); the PNGs each trial writes do not.
#
# The leading ** matters. A gitignore pattern containing a slash is anchored to
# the repo root, so a bare "erc_images/*" silently misses src/erc_images/ -
# which is where the node actually writes, since only src/ is bind-mounted into
# the container.
**/erc_images/*
!**/erc_images/.gitkeep

# Loose detection images from before erc_images/ existed
/detected_*.png

# --- Editors ---
.vscode/
.idea/
*.swp
